FROM docker.io/library/ubuntu:24.04
ARG RUST_VERSION=1.100.0
ARG BUN_VERSION=1.4.4
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl unzip build-essential cmake pkg-config libclang-dev libssl-dev \
    libpipewire-0.3-dev libdbus-1-dev libwebkit2gtk-4.1-dev libgtk-3-dev \
    libayatana-appindicator3-dev librsvg2-dev libasound2-dev libopus-dev \
    tesseract-ocr tesseract-ocr-eng git file binutils python3 xvfb xauth \
    && apt-get clean
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo BUN_INSTALL=/opt/bun
ENV PATH=/opt/cargo/bin:/opt/bun/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs -o /opt/rustup-init.sh \
    && sh /opt/rustup-init.sh -y --profile minimal --default-toolchain "${RUST_VERSION}"
RUN case "$(uname -m)" in aarch64) arch=aarch64 ;; x86_64) arch=x64 ;; *) exit 1 ;; esac \
    && curl -fL "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-${arch}.zip" -o /opt/bun.zip \
    && unzip /opt/bun.zip -d /opt \
    && mkdir -p /opt/bun/bin \
    && cp "/opt/bun-linux-${arch}/bun" /opt/bun/bin/bun
WORKDIR /work
CMD ["bash", "scripts/build-linux.sh"]
